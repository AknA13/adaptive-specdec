#!/bin/bash
# Machine-specific configuration. Copy to env.sh (git-ignored) and edit.
#
#   cp env.sh.example env.sh && $EDITOR env.sh
#
# Every scripts/*.sh sources this via scripts/lib.sh.

# --- interpreter -------------------------------------------------------------
# Needs torch / transformers / vllm. On this cluster that is the `rl` env.
# NOTE: that env is fragile (mixed torch 2.9.0 / 2.11.0 dist-info, cu12+cu13
# wheels side by side). Never run a `pip install` in it that resolves torch.
export SPEC_PY="${SPEC_PY:-/scratch/users/akshay_anand/conda/envs/rl/bin/python}"

# --- where artifacts go ------------------------------------------------------
# MUST NOT be $HOME (10G quota, ~2G free) or /scratch (20G quota, ~10G free).
# /data is node-local and unquota'd; from another node read it as /net/<node>/data.
export SPEC_DATA_ROOT="${SPEC_DATA_ROOT:-/data/$USER/specdec}"

# --- models ------------------------------------------------------------------
export SPEC_TARGET_ID="${SPEC_TARGET_ID:-Qwen/Qwen3-8B}"
export SPEC_DRAFT_ID="${SPEC_DRAFT_ID:-Qwen/Qwen3-0.6B}"

# --- HuggingFace cache -------------------------------------------------------
# Qwen3-0.6B is cached ONLY on horton. Qwen3-8B is on horton/thidwick/lorax.
export HF_HOME="${HF_HOME:-/data/$USER/huggingface-cache}"
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"
export HF_DATASETS_OFFLINE="${HF_DATASETS_OFFLINE:-1}"
# .bashrc still exports the deprecated TRANSFORMERS_CACHE, which shadows HF_HOME.
unset TRANSFORMERS_CACHE

# Where tests/test_vllm_patches.py looks for Qwen3 snapshots. It runs on the
# login node, which cannot see node-local /data, so it needs the /net view.
export SPEC_HF_HUB="${SPEC_HF_HUB:-/net/horton/data/$USER/huggingface-cache/hub}"

# --- SLURM (used by slurm/submit.sh) -----------------------------------------
export SPEC_SLURM_PARTITION="${SPEC_SLURM_PARTITION:-berkeleynlp}"
export SPEC_SLURM_QOS="${SPEC_SLURM_QOS:-normal}"
# Pin horton: it is the only node with Qwen3-0.6B cached, and /data is node-local
# so artifacts written by one stage are only local to the node that wrote them.
# `-` not `:-`: an explicitly EMPTY value must survive, meaning "let SLURM pick"
# (pair it with SPEC_SLURM_EXCLUDE=thidwick once artifacts exist on >1 node).
export SPEC_SLURM_NODELIST="${SPEC_SLURM_NODELIST-horton}"
export SPEC_SLURM_EXCLUDE="${SPEC_SLURM_EXCLUDE:-}"          # e.g. thidwick (no Qwen3-0.6B there); pairs with an empty NODELIST
export SPEC_SLURM_CPUS="${SPEC_SLURM_CPUS:-32}"
export SPEC_SLURM_TIME="${SPEC_SLURM_TIME:-8:00:00}"
# Self-imposed etiquette cap, enforced by slurm/submit.sh.
export SPEC_MAX_GPUS="${SPEC_MAX_GPUS:-4}"

# --- knobs -------------------------------------------------------------------
export SPEC_K_MAX="${SPEC_K_MAX:-8}"
export SPEC_VLLM_TP="${SPEC_VLLM_TP:-1}"

# --- optional knobs read by scripts/*.sh -------------------------------------
# All have sensible defaults; set them to change a stage without editing it.
export SPEC_TRACE_DATASET="${SPEC_TRACE_DATASET:-gsm8k}"   # trace source (train split)
export SPEC_TRACE_SPLIT="${SPEC_TRACE_SPLIT:-train}"
export SPEC_TRACE_N="${SPEC_TRACE_N:-0}"                   # 0 = all problems
export SPEC_TRACE_SHARDS="${SPEC_TRACE_SHARDS:-}"          # default: one per visible GPU
export SPEC_STOP_AFTER_SEC="${SPEC_STOP_AFTER_SEC:-0}"     # training checkpoint-and-exit budget
export SPEC_MASTER_PORT="${SPEC_MASTER_PORT:-}"            # torchrun rendezvous port
export SPEC_TRAIN_MAXLEN="${SPEC_TRAIN_MAXLEN:-2560}"      # prompt+completion window for draft training
export SPEC_BENCH_N="${SPEC_BENCH_N:-40}"                  # problems per engine benchmark
export SPEC_BENCH_NEW="${SPEC_BENCH_NEW:-256}"             # max new tokens per request
export SPEC_BENCH_REQS="${SPEC_BENCH_REQS:-64}"            # requests per concurrency level
export SPEC_BENCH_CONC="${SPEC_BENCH_CONC:-1,4,16,64}"     # serving concurrency sweep
export SPEC_LABEL_SUFFIX="${SPEC_LABEL_SUFFIX:-}"         # suffix serving result labels, for follow-up passes
export SPEC_SWEEP_KS="${SPEC_SWEEP_KS:-}"                 # subset of fixed-k values to sweep (default "2 4 8")
export SPEC_VLLM_PORT="${SPEC_VLLM_PORT:-}"                # default: random high port
export SPEC_VLLM_MAXLEN="${SPEC_VLLM_MAXLEN:-4096}"
export SPEC_VLLM_GMU="${SPEC_VLLM_GMU:-0.85}"              # NB: 64 KV layers, not 36
export SPEC_VLLM_CACHE="${SPEC_VLLM_CACHE:-}"             # vLLM torch.compile cache (default $SPEC_DATA_ROOT/vllm-cache)
export SPEC_MIN_FREE_MIB="${SPEC_MIN_FREE_MIB:-40000}"     # GPUs here are oversubscribed; wait for this much free
# SPEC_QUIET_ENV=1 silences the "no env.sh" notice (set by slurm/submit.sh).
# SPECDEC_PLUGIN=1 arms the vLLM plugin; SPECDEC_CONTROLLER picks the policy.
# Both are set by scripts/05_bench_vllm.sh, not here.
